# Makefile.shift — thin compatibility wrapper (BUILD-002).
#
# The shift/audit/test targets live in mk/shift.mk, which the top-level
# Makefile includes.  Use the single entry point for new work:
#
#   make audit
#   make smoke
#   make shift-check TOOLCHAIN=/path/to/arm-none-eabi-
#
# This file keeps `make -f Makefile.shift <target>` working for existing
# scripts and docs.  It forwards every goal and every command-line variable to
# `make -f Makefile`, in one sub-make, so -j and goal ordering behave the same.
#
# With no target this wrapper still means `audit` (the old standalone default
# goal), never a normal ROM build.  The explicit `all` goal keeps the same
# legacy meaning (`all: audit` in the old file).
#
# Exit status: the forwarded make's status is this make's status.  A skipped
# emulator scenario still prints `SKIP (77)`; GNU make reports the failed
# recipe as exit 2, exactly as it did when these targets lived here.

# Goals requested on the command line; the bare `all` goal keeps its legacy
# meaning instead of forwarding to the ROM build.
SHIFT_WRAPPER_GOALS := $(if $(MAKECMDGOALS),$(MAKECMDGOALS),audit)
ifeq ($(SHIFT_WRAPPER_GOALS),all)
SHIFT_WRAPPER_GOALS := audit
endif

.DEFAULT_GOAL := $(firstword $(SHIFT_WRAPPER_GOALS))

.PHONY: __shift_forward $(SHIFT_WRAPPER_GOALS)

# Single sub-make for the whole command line.  $(MAKE) propagates MAKEFLAGS,
# which carries -j/-k/-n and every VAR=value given on the command line.
__shift_forward:
	@$(MAKE) --no-print-directory -f Makefile $(SHIFT_WRAPPER_GOALS)

# Satisfied by the one forwarded run above; no recipe of their own.
$(SHIFT_WRAPPER_GOALS): __shift_forward
