+		if (!mfWatchLog) {
+			mfWatchLog = fopen(watchPath, "w");
+		}
+		const char* minFrame = getenv("MF_WATCH_FRAME_MIN");
+		const char* maxFrame = getenv("MF_WATCH_FRAME_MAX");
+		if (minFrame) mfWatchFrameMin = atoi(minFrame);
+		if (maxFrame) mfWatchFrameMax = atoi(maxFrame);
+		mfStoreTrace = mfWatchCallback;
+	}
+
 	ctx->core->setVideoBuffer(ctx->core, ctx->vbuff, VIDEO_HORIZONTAL_PIXELS);
 	ctx->core->setAudioBufferSize(ctx->core, 1024);
 
