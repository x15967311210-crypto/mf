@@ -107,6 +114,25 @@ static void logdebug(struct mLogger* logger, int category, enum mLogLevel level,
 
 }
 
+static FILE* mfWatchLog;
+static int mfWatchFrameMin = -1;
+static int mfWatchFrameMax = -1;
+
+static void mfWatchCallback(struct GBA* gba, uint32_t address, uint32_t value,
+	int size, uint32_t pc) {
+	if (!mfWatchLog) return;
+	int frame = gba->video.frameCounter;
+	if (mfWatchFrameMin >= 0 && frame < mfWatchFrameMin) return;
+	if (mfWatchFrameMax >= 0 && frame > mfWatchFrameMax) return;
+	struct ARMCore* cpu = gba->cpu;
+	fprintf(mfWatchLog, "%d %d %d %08X %08X %08X %08X %08X %08X %d %d %d\n",
+		frame, gba->video.vcount, mTimingCurrentTime(&gba->timing),
+		(uint32_t) cpu->gprs[15], (uint32_t) cpu->gprs[14],
+		(uint32_t) cpu->gprs[13], (uint32_t) cpu->cpsr.packed,
+		address, value, size, gba->performingDMA, gba->memory.activeDMA);
+	fflush(mfWatchLog);
+}
+
 static void resetinternal(bizctx* ctx)
 {
 	ctx->core->reset(ctx->core);
